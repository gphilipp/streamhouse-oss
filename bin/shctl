#!/usr/bin/env sh
# shctl launcher. Build first: mvn -pl cli -am package -DskipTests
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
JAR="$ROOT/cli/target/quarkus-app/quarkus-run.jar"
if [ ! -f "$JAR" ]; then
  echo "shctl is not built yet; run: make build" >&2
  exit 1
fi
if [ -n "$JAVA_HOME" ]; then
  JAVA="$JAVA_HOME/bin/java"
elif [ -x /opt/homebrew/opt/openjdk@21/bin/java ]; then
  JAVA=/opt/homebrew/opt/openjdk@21/bin/java
else
  JAVA=java
fi
exec "$JAVA" -jar "$JAR" "$@"
