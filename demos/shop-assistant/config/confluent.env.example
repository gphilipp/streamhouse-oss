# Confluent Cloud settings for the shop-assistant demo.
# Copy to confluent.env (git-ignored) and fill in. Every value is required unless marked optional.

PLATFORM=confluent

# --- Identifiers -------------------------------------------------------------------------------
CONFLUENT_ORG_ID=                 # organization id (UUID), Console > Organization settings
CONFLUENT_ENV_ID=                 # env-xxxxx
CONFLUENT_KAFKA_CLUSTER_ID=       # lkc-xxxxx (AWS, in a region where the Real-Time Context Engine is available)
CONFLUENT_CLOUD=AWS
CONFLUENT_REGION=                 # e.g. us-east-1
CONFLUENT_FLINK_COMPUTE_POOL_ID=  # lfcp-xxxxx
CONFLUENT_FLINK_PRINCIPAL=        # optional: sa-xxxxx service account that owns the Flink statements
# Flink addresses tables as `<environment display name>`.`<cluster display name>`.`<topic>`
CONFLUENT_ENV_NAME=
CONFLUENT_KAFKA_CLUSTER_NAME=
# Schema Registry of the environment (used to tell when topics have schemas)
CONFLUENT_SCHEMA_REGISTRY_URL=    # https://psrc-xxxxx.<region>.aws.confluent.cloud
CONFLUENT_SCHEMA_REGISTRY_API_KEY=
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=
# Optional: warehouse name passed when attaching the Iceberg REST catalog (empty works for most accounts)
CONFLUENT_ICEBERG_WAREHOUSE=

# --- API keys ----------------------------------------------------------------------------------
# Global API key: management APIs (connectors, Flink statements, Iceberg tables, context engine),
# the MCP endpoint (which requires a global key) and the Iceberg REST catalog.
CONFLUENT_GLOBAL_API_KEY=
CONFLUENT_GLOBAL_API_SECRET=
# Kafka API key for the cluster: the managed CDC connector writes with it.
CONFLUENT_KAFKA_API_KEY=
CONFLUENT_KAFKA_API_SECRET=

# --- Source database (must be reachable from Confluent Cloud; logical replication enabled) ------
SOURCE_PG_HOST=
SOURCE_PG_PORT=5432
SOURCE_PG_DATABASE=shop
SOURCE_PG_USER=                   # owner, used by the simulator and to load the schema
SOURCE_PG_PASSWORD=
SOURCE_PG_CDC_USER=               # replication user for the connector (may equal SOURCE_PG_USER)
SOURCE_PG_CDC_PASSWORD=
SOURCE_PG_SSLMODE=require

