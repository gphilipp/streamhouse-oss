# Streamhouse OSS running locally (make up). No secrets here: these are the local demo credentials.
PLATFORM=oss

OSS_CONTROL_PLANE_URL=http://localhost:8080
OSS_OIDC_ISSUER=http://localhost:8180/realms/streamhouse
OSS_ADMIN_USER=admin
OSS_ADMIN_PASSWORD=admin
OSS_SCHEMA_REGISTRY_URL=http://localhost:8085/apis/ccompat/v7

# Source database: the simulator connects from the host, the CDC connector from inside the platform.
SOURCE_PG_HOST=localhost
SOURCE_PG_PORT=5433
SOURCE_PG_DATABASE=shop
SOURCE_PG_USER=shop
SOURCE_PG_PASSWORD=shop
SOURCE_PG_SSLMODE=disable
SOURCE_PG_CDC_USER=debezium
OSS_SOURCE_PG_HOST=shop-db
OSS_SOURCE_PG_PORT=5432
OSS_SOURCE_PASSWORD_SECRET=shop_pg_pwd
OSS_SOURCE_PUBLICATION=streamhouse

# Iceberg REST catalog (Gravitino) and object storage (SeaweedFS)
OSS_ICEBERG_REST_URL=http://localhost:9001/iceberg/
OSS_ICEBERG_NAMESPACE=streamhouse
OSS_S3_ENDPOINT=http://localhost:8333
OSS_S3_ACCESS_KEY=streamhouse
OSS_S3_SECRET_KEY=streamhouse-secret

# Real-time context over MCP. The agent authenticates with an API key/secret (a Keycloak client).
OSS_MCP_URL=http://localhost:8082/mcp
OSS_AGENT_API_KEY=support-agent
OSS_AGENT_API_SECRET=support-agent-secret
OSS_AGENT_ROLE=support_agent

